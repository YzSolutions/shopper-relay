# Copy to .env.local and fill in. .env.local is git-ignored.

# Branding (product name is not final)
NEXT_PUBLIC_BRAND_NAME=Working Title
NEXT_PUBLIC_BRAND_TAGLINE=Shopping help you control.
NEXT_PUBLIC_DEMO_OWNER_NAME=Mom
NEXT_PUBLIC_DEMO_CONTACT_NAME=Sarah

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after creating a webhook for your deployed URL
PAYPAL_WEBHOOK_ID=

# Channel3: trychannel3.com/developers (promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# Gemini: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
